PORT=8787

# Photon 2.0 Beta credentials from https://app.beta.photon.codes
PHOTON_MODE=mock
# imessage (default) uses Photon shared iMessage lines, no 10DLC needed. sms needs an approved campaign.
PHOTON_CHANNEL=imessage
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
PHOTON_AGENT_USER_ID=
PHOTON_PHONE_NUMBER=
PHOTON_RESOURCE_ID=

# Photon Voice SIP profile from the Photon Beta dashboard.
PHOTON_SIP_INBOUND_ADDRESS=sips:sip.rtc.elevenlabs.io:5061
PHOTON_SIP_ADDRESS=sip.photon.codes:5061
PHOTON_SIP_USERNAME=
PHOTON_SIP_PASSWORD=

# Published ElevenLabs agent assigned to the imported Photon number.
ELEVENLABS_AGENT_ID=
# Set live to text through Photon and dial through ElevenLabs for Mirage/urgent alerts.
# Live mode fails startup until all required credentials and a real registered ANALYST_PHONE are set.
VOICE_MODE=mock
ELEVENLABS_API_KEY=
# phone_number_id of the Photon number imported into ElevenLabs as a SIP trunk.
ELEVENLABS_PHONE_NUMBER_ID=
# Shared secret ElevenLabs sends as the x-batman-secret header on the
# initiation webhook (/voice/init) and every server tool (/voice/tools/*).
VOICE_WEBHOOK_SECRET=
# HMAC secret ElevenLabs shows when you create the post-call webhook (/voice/post-call).
ELEVENLABS_WEBHOOK_SECRET=

# Defense lane (Person 2). Everything runs mocked when keys are empty.
ANTHROPIC_API_KEY=
DAYTONA_API_KEY=
FACTORY_API_KEY=
# Cage fleet concurrency (agents running at once for /cage/fleet/start). Two different limits:
#  - SCRIPTED agents run in-process: bounded by Daytona's CPU budget. Each sandbox ~= CAGE_VCPU_PER_VM vCPU (default 4),
#    account has CAGE_CPU_BUDGET total vCPU (Tier 3 = 250), so scripted-only fleets default to ~budget/per minus
#    headroom (~60 on Tier 3). Going higher fails VMs with "Total CPU limit exceeded". CAGE_MAX_VMS overrides this.
#  - LIVE DROID agents each spawn a local droid CLI subprocess + MCP server: bounded by THIS machine's RAM, not CPU.
#    Any fleet with live Droid defaults to CAGE_MAX_LIVE_DROID at once (default 8); too many OOM-kills the server.
# ?concurrency=N overrides either, per run.
CAGE_CPU_BUDGET=250
CAGE_VCPU_PER_VM=4
CAGE_MAX_LIVE_DROID=8
CAGE_MAX_VMS=
# CAGE_TOKEN_BUDGET = stop starting new agents after this many tokens on a run (empty = no budget; ~60k tokens/Droid).
CAGE_TOKEN_BUDGET=
# Optional: DROID_MODEL (Droid model id), DROID_PATH (droid binary; default from the droid npm package), DROID_DEBUG=1
# (print the Droid CLI stream to stderr). Each live Droid agent is capped by CAGE_MAX_STEPS / CAGE_MAX_SECONDS below.
# CAGE_MIRAGE_LATENCY_MS = progressive latency for mirage replies in server runs (ms per loop level, max 3 s; default 250).
CAGE_MIRAGE_LATENCY_MS=250
# Who Batman texts and calls. Must be an analyst in data/users.json (e.g. +17372155908 for testing).
ANALYST_PHONE=+15550001002
SANDBOX_BACKEND=local   # set to "daytona" to use real Daytona sandboxes
# Investigator: "gemini" uses the free Gemini model below, anything else uses the built-in rules.
INVESTIGATOR=rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Chalk Model Gateway for the investigator (INVESTIGATOR=chalk). The provider key lives in Chalk,
# not here. Create a key with: chalk router api-key create --model <model>
CHALK_ROUTER_URL=https://api.chalk.ai/v1/router
CHALK_ENV_ID=
CHALK_ROUTER_API_KEY=
CHALK_MODEL=openai/gpt-4.1-mini-2025-04-14

# Cage kill switch (Person A). Independent of the watcher; a hard stop on either of these. There is no dollar cap
# (we never see a billed cost); the spend control is CAGE_TOKEN_BUDGET / --token-budget on fleet runs.
CAGE_MAX_STEPS=40
CAGE_MAX_SECONDS=180
